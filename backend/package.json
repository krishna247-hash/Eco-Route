{
  "name": "ecoroute-backend",
  "version": "1.0.0",
  "description": "EcoRoute API — Express + Prisma",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "test": "node --import tsx --test tests/**/*.test.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcrypt": "6.0.0",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "jsonwebtoken": "9.0.2",
    "redis": "4.7.0"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.0",
    "@types/supertest": "6.0.2",
    "nodemon": "3.1.7",
    "prisma": "5.20.0",
    "supertest": "7.3.0",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.6.3"
  }
}
