DATABASE_URL="postgresql://ecoroute:ecoroute@localhost:5432/ecoroute?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
AI_SERVICE_URL="http://localhost:8000"
REDIS_URL="redis://localhost:6379"
PORT=4000

# Optional. Without this, GET /api/v1/payments/status reports
# {"configured": false} and POST /api/v1/payments/checkout returns a
# clean 503 -- no payment is ever faked as successful. Get a free test
# key from https://dashboard.stripe.com/test/apikeys to enable real
# Stripe Checkout (test mode).
# STRIPE_SECRET_KEY="sk_test_..."
